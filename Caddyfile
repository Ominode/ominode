# Caddy reverse proxy for Ominode — automatic HTTPS via Let's Encrypt.
# DOMAIN is injected from the docker-compose environment.
#
# Cloudflare notes:
#   - DNS only (grey cloud): works out of the box.
#   - Proxied (orange cloud): set SSL/TLS mode to "Full (strict)"; Caddy's
#     HTTP-01 challenge passes through Cloudflare, so issuance still works.
#   - Port 80 must stay reachable for certificate renewal.

{$DOMAIN}

# Reverse proxy to the ominode container
reverse_proxy ominode:3000

# Docs site (requires the `docs` service enabled in docker-compose.yml)
docs.{$DOMAIN} {
	reverse_proxy docs:80
	header {
		-Server
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}
}

# Security headers
header {
	-Server
	X-Content-Type-Options nosniff
	X-Frame-Options DENY
	Referrer-Policy strict-origin-when-cross-origin
}

# Access log
log {
	output stdout
	format console
}
